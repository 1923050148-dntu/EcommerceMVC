@model IEnumerable<ECommerceMVC.ViewModels.FeaturedProductVM>

<div class="col-lg-12">
    <h4 class="mb-4 fw-bold">Featured products</h4>
    @foreach (var item in Model)
    {
        <div class="d-flex align-items-center justify-content-start mb-4">
            <div class="rounded me-4" style="width: 100px; height: 100px;">
                <a asp-controller="HangHoa" asp-action="Detail" asp-route-id="@item.MaHh">
                    <img src="~/Hinh/HangHoa/@item.Hinh" class="img-fluid rounded" alt="@item.TenHh" style="width: 100%; height: 100%; object-fit: cover;">
                </a>
            </div>
            <div>
                <a asp-controller="HangHoa" asp-action="Detail" asp-route-id="@item.MaHh">
                    <h6 class="mb-2 text-dark fw-bold">@item.TenHh</h6>
                </a>
                <div class="d-flex mb-2">
                    @for (int i = 0; i < 5; i++)
                    {
                        <i class="fa fa-star @(i < item.DiemDanhGia ? "text-secondary" : "text-muted")"></i>
                    }
                </div>
                <div class="d-flex mb-2">
                    <h5 class="fw-bold me-2 text-dark">@item.DonGia.ToString("#,##0") đ</h5>
                    <h5 class="text-danger text-decoration-line-through small">@item.GiaGoc.ToString("#,##0") đ</h5>
                </div>
            </div>
        </div>
    }
    <div class="d-flex justify-content-center my-4">
        <a href="#" class="btn border border-secondary px-4 py-3 rounded-pill text-primary w-100">View More</a>
    </div>
</div>