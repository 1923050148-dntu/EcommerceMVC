@model IEnumerable<ECommerceMVC.ViewModels.HangHoaVM>

@{
    ViewData["Title"] = "Trang chủ - HSHOP2023";
}

<div class="container-fluid py-5 mb-5 hero-header" style="background-color: #f4f7f4;">
    <div class="container py-5">
        <div class="row g-4 align-items-start">
            @* Cột Menu bên trái *@
            <div class="col-lg-3">
                @await Component.InvokeAsync("MenuLoai")
            </div>

            @* Cột nội dung bên phải *@
            <div class="col-lg-9">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h1 class="display-6 fw-bold text-dark">HSHOP2023</h1>

                    <form asp-controller="HangHoa" asp-action="Search" method="get">
                        <div class="input-group" style="width: 300px;">
                            <input type="text" name="query" class="form-control border-secondary bg-white py-2" placeholder="Tìm sản phẩm...">
                            <button type="submit" class="btn btn-light border border-secondary border-start-0">
                                <i class="fa fa-search text-secondary"></i>
                            </button>
                        </div>
                    </form>
                </div>

                <div class="hero-header rounded p-5" style="background-color: #ffb52421;">
                    <div class="row g-5 align-items-center">
                        <div class="col-md-12 col-lg-7">
                            <h4 class="mb-3 text-secondary">HSHOP2023 Cam Kết 100% Chính Hãng</h4>
                            <h1 class="mb-5 display-4 text-primary">Sản Phẩm Công Nghệ & Đồ Gia Dụng</h1>
                        </div>
                        <div class="col-md-12 col-lg-5">
                            <div id="carouselId" class="carousel slide" data-bs-ride="carousel">
                                <div class="carousel-inner" role="listbox">
                                    <div class="carousel-item active rounded">
                                        <img src="~/img/hero-img-1.png" class="img-fluid w-100 rounded" alt="Slide 1">
                                    </div>
                                    <div class="carousel-item rounded">
                                        <img src="~/img/hero-img-2.jpg" class="img-fluid w-100 rounded" alt="Slide 2">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* PHẦN DANH SÁCH SẢN PHẨM *@
        <div class="row g-4 mt-5">
            <div class="text-center mx-auto mb-5" style="max-width: 700px;">
                <h1 class="display-5 text-dark fw-bold">Sản phẩm của chúng tôi</h1>
                <p class="text-muted">Chất lượng hàng đầu - Giao hàng cực nhanh</p>
            </div>

            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="rounded position-relative fruite-item border border-secondary shadow-sm bg-white h-100 d-flex flex-column">
                        <div class="fruite-img overflow-hidden">
                            <a asp-controller="HangHoa" asp-action="Detail" asp-route-id="@item.MaHh">
                                <img src="~/Hinh/HangHoa/@item.Hinh" class="img-fluid w-100 rounded-top" alt="@item.TenHh" style="height: 220px; object-fit: cover;">
                            </a>
                        </div>

                        <div class="text-white bg-secondary px-3 py-1 rounded position-absolute" style="top: 10px; left: 10px; z-index: 5;">
                            @item.TenLoai
                        </div>

                        <div class="p-4 flex-grow-1 d-flex flex-column">
                            <a asp-controller="HangHoa" asp-action="Detail" asp-route-id="@item.MaHh">
                                <h5 class="text-dark fw-bold mb-2" style="height: 45px; overflow: hidden;">@item.TenHh</h5>
                            </a>

                            @* Thêm phần Đánh giá sao *@
                            <div class="d-flex mb-2">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="fa fa-star @(i <= item.DiemDanhGia ? "text-warning" : "text-muted")"></i>
                                }
                            </div>

                            <p class="text-muted small mb-3" style="height: 50px; overflow: hidden;">@item.MoTaNgan</p>

                            <div class="mt-auto">
                                @* Thêm phần Giá giảm đỏ *@
                                <div class="d-flex align-items-center mb-3">
                                    @if (item.GiaGoc > item.DonGia)
                                    {
                                        <span class="text-muted text-decoration-line-through me-2 small">@item.GiaGoc.ToString("#,##0") đ</span>
                                    }
                                    <span class="text-danger fs-5 fw-bold">@item.DonGia.ToString("#,##0") đ</span>
                                </div>

                                <div class="d-flex gap-2">
                                    <a asp-controller="HangHoa" asp-action="Detail" asp-route-id="@item.MaHh" class="btn btn-outline-primary border border-secondary rounded-pill px-3 flex-fill">
                                        <i class="fa fa-eye me-2"></i> Chi tiết
                                    </a>

                                    @* Nút Mua ngay dùng Ajax cực mượt *@
                                    <button type="button" class="btn border border-secondary rounded-pill px-3 text-primary flex-fill add-to-cart" data-id="@item.MaHh">
                                        <i class="fa fa-shopping-bag me-2 text-primary"></i> Mua
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .fruite-item {
        transition: all 0.4s ease;
        cursor: pointer;
    }

        .fruite-item:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
            border-color: #81c408 !important;
        }

    .fruite-img img {
        transition: transform 0.6s ease;
    }

    .fruite-item:hover .fruite-img img {
        transform: scale(1.1);
    }

    a {
        text-decoration: none !important;
    }
</style>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            $(document).on('click', ".add-to-cart", function (e) {
                e.preventDefault();
                var id = $(this).data("id");
                $.ajax({
                    url: "/Cart/AddToCart",
                    type: "GET",
                    data: { id: id, quantity: 1 },
                    success: function (response) {
                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Tuyệt vời!',
                                text: 'Đã thêm sản phẩm vào giỏ hàng !',
                                showConfirmButton: false,
                                timer: 1500
                            });
                            // Cập nhật số lượng trên icon giỏ hàng
                            $(".cart-count").text(response.cartCount);
                        }
                    },
                    error: function () {
                        Swal.fire({ icon: 'error', title: 'Lỗi rồi...', text: 'Không kết nối được server!' });
                    }
                });
            });
        });
    </script>
}