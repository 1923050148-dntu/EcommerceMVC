@model ECommerceMVC.ViewModels.DangKyVM
@{
    ViewData["Title"] = "Gia nhập cộng đồng HSHOP";
}

<div class="container py-5 mt-5">
    <div class="row justify-content-center animate__animated animate__fadeIn">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-0">
                <div class="card-body p-5">
                    <div class="text-center mb-5">
                        <h2 class="letter-spacing-3 fw-bold" style="font-family: 'Cormorant Garamond', serif;">BECOME A MEMBER</h2>
                        <p class="text-muted small">Khám phá những đặc quyền dành riêng cho giới thượng lưu.</p>
                    </div>

                    <form asp-action="DangKy" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="row">
                            <div class="col-md-12 mb-4">
                                <label class="small text-muted text-uppercase letter-spacing-1">Tên tài khoản *</label>
                                <input asp-for="MaKh" class="form-control border-0 border-bottom rounded-0 px-0 shadow-none" placeholder="Username" />
                                <span asp-validation-for="MaKh" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12 mb-4">
                                <label class="small text-muted text-uppercase letter-spacing-1">Họ và Tên *</label>
                                <input asp-for="HoTen" class="form-control border-0 border-bottom rounded-0 px-0 shadow-none" placeholder="Full Name" />
                                <span asp-validation-for="HoTen" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12 mb-4">
                                <label class="small text-muted text-uppercase letter-spacing-1">Địa chỉ Email</label>
                                <input asp-for="Email" class="form-control border-0 border-bottom rounded-0 px-0 shadow-none" placeholder="email@example.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12 mb-5">
                                <label class="small text-muted text-uppercase letter-spacing-1">Mật khẩu *</label>
                                <input asp-for="MatKhau" type="password" class="form-control border-0 border-bottom rounded-0 px-0 shadow-none" placeholder="••••••••" />
                                <span asp-validation-for="MatKhau" class="text-danger small"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-dark w-100 rounded-0 py-3 text-uppercase letter-spacing-2 mb-4" style="background: #111;">
                            Tạo tài khoản
                        </button>
                    </form>

                    <div class="text-center">
                        <span class="text-muted small">Đã có tài khoản?</span>
                        <a asp-action="DangNhap" class="text-dark small fw-bold text-decoration-none border-bottom border-dark ms-1">Đăng nhập</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .letter-spacing-3 {
        letter-spacing: 5px;
    }

    .letter-spacing-2 {
        letter-spacing: 2px;
    }

    .letter-spacing-1 {
        letter-spacing: 1px;
    }

    input:focus {
        border-color: #c5a059 !important;
    }

    .form-control::placeholder {
        color: #ccc;
        font-size: 0.9rem;
        font-weight: 300;
    }
</style>