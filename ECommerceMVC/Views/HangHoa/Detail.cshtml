@model ECommerceMVC.ViewModels.ChiTietHangHoaVM
@{
    ViewData["Title"] = "HSHOP2023 - Chi tiết sản phẩm";
    Layout = "_LayoutCustomer";
}

<div class="container-fluid py-5 mt-5">
    <div class="container py-5">
        <div class="row g-4 mb-5">
            <div class="col-lg-8 col-xl-9">
                <div class="row g-4">
                    <div class="col-lg-6">
                        <div class="border rounded">
                            <a href="#">
                                <img src="~/Hinh/HangHoa/@Model.Hinh" class="img-fluid rounded" alt="@Model.TenHh">
                            </a>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <h4 class="fw-bold mb-3">@Model.TenHh</h4>
                        <p class="mb-3">Danh mục: <span class="text-primary fw-bold">@Model.TenLoai</span></p>
                        <h5 class="fw-bold mb-3 text-danger">@Model.DonGia.ToString("#,##0") đ</h5>

                        <div class="d-flex mb-4">
                            @for (int i = 0; i < Model.DiemDanhGia; i++)
                            {
                                <i class="fa fa-star text-secondary"></i>
                            }
                        </div>

                        <p class="mb-4">@Model.MoTaNgan</p>

                        @* Ô nhập số lượng *@
                        <div class="input-group quantity mb-5" style="width: 100px;">
                            <input type="number" id="txtSoLuong" class="form-control form-control-sm text-center border-0" value="1" min="1">
                        </div>

                        @* Nút Mua ngay *@
                        <button type="button" class="btn border border-secondary rounded-pill px-4 py-2 mb-4 text-primary btn-add-to-cart" data-id="@Model.MaHh">
                            <i class="fa fa-shopping-bag me-2 text-primary"></i> Mua ngay
                        </button>
                    </div>

                    <div class="col-lg-12">
                        <nav>
                            <div class="nav nav-tabs mb-3">
                                <button class="nav-link active border-white border-bottom-0" type="button">Thông tin chi tiết</button>
                            </div>
                        </nav>
                        <div class="tab-content mb-5">
                            <div class="tab-pane active" role="tabpanel">
                                <p>@Html.Raw(Model.ChiTiet)</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-xl-3">
                @await Component.InvokeAsync("MenuLoai")
                @await Component.InvokeAsync("FeaturedProduct")
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Lắng nghe sự kiện click vào nút có class btn-add-to-cart
            $(".btn-add-to-cart").click(function () {
                var maHh = $(this).data("id");
                var soLuong = $("#txtSoLuong").val();

                $.ajax({
                    url: "/Cart/AddToCart",
                    data: { id: maHh, quantity: soLuong },
                    success: function (response) {
                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Tuyệt vời!',
                                text: 'Đã thêm vào giỏ hàng thành công!',
                                showConfirmButton: false,
                                timer: 1500
                            });
                            // Cập nhật số lượng trên icon giỏ hàng ở Header
                            $(".cart-count").text(response.cartCount);
                        }
                    },
                    error: function() {
                        alert("Có lỗi xảy ra, kiểm tra lại Controller nhé!");
                    }
                });
            });
        });
    </script>
}